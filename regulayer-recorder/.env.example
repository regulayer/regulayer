# Example environment configuration
# Copy to .env and fill in with actual values

# Database
DATABASE_URL=postgresql://regulayer:password@localhost:5432/regulayer_recorder

# Security
HMAC_SECRET_KEY=your-very-long-secret-key-at-least-32-characters-long

# Service Configuration
LOG_LEVEL=INFO
ALLOWED_SDK_VERSIONS=1.0.0
MAX_TIMESTAMP_DRIFT_SECONDS=300

# Chain Configuration
CHAIN_ID=global

# Server Configuration
HOST=0.0.0.0
PORT=8000
