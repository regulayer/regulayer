# Regulayer Caddyfile - Automatic HTTPS & Reverse Proxy

# Route API Gateway Traffic
api.{$REGULAYER_DOMAIN} {
    # CORS headers on ALL responses (preflight + normal)
    header Access-Control-Allow-Origin "https://{$REGULAYER_DOMAIN}"
    header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    header Access-Control-Allow-Headers "*"
    header Access-Control-Expose-Headers "*"
    header Access-Control-Max-Age "600"

    # Preflight: return 204 immediately (headers already set above)
    @options method OPTIONS
    respond @options 204

    # Everything else: proxy to gateway
    reverse_proxy gateway:8080
}

# Route Frontend Web Traffic
{$REGULAYER_DOMAIN} {
    reverse_proxy web:3000
}
