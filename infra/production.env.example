# Regulayer Production Configuration
# Copy to .env.prod and secure it!

# ============================================================
# Core Environment
# ============================================================
ENV=prod
LOG_LEVEL=INFO
DOMAIN=regulayer.tech

# ============================================================
# Secrets (Rotate these!)
# ============================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
GOVERNANCE_INTERNAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
INCIDENTS_INTERNAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ============================================================
# Database (PostgreSQL)
# ============================================================
DATABASE_URL=postgresql://user:password@db:5432/regulayer
INCIDENTS_DATABASE_URL=postgresql://user:password@db:5432/incidents
GOVERNANCE_DATABASE_URL=postgresql://user:password@db:5432/governance

# ============================================================
# Stripe Billing
# ============================================================
STRIPE_API_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================
# Feature Flags
# ============================================================
DEMO_MODE_ENABLED=false
ALLOW_LEGACY_INGESTION=false
RECORDER_KEY_ROTATION_ALLOWED=false
SERVICE_FAIL_FAST=true
GATEWAY_MODE=prod

# ============================================================
# Support & Legal
# ============================================================
SUPPORT_EMAIL=support@regulayer.tech
SECURITY_EMAIL=security@regulayer.tech
