CONTROL_DB_URL=postgresql://control_user:Ssancheet23@database-1.cd68eqm8qlzp.eu-north-1.rds.amazonaws.com:5432/regulayer_control?sslmode=require

GOVERNANCE_DB_URL=postgresql://governance_user:Ssancheet23@database-1.cd68eqm8qlzp.eu-north-1.rds.amazonaws.com:5432/regulayer_governance?sslmode=require

INCIDENTS_DB_URL=postgresql://incidents_user:Ssancheet23@database-1.cd68eqm8qlzp.eu-north-1.rds.amazonaws.com:5432/regulayer_incidents?sslmode=require

# API Keys & Secrets
HMAC_SECRET_KEY=dev_secret_key_change_in_prod_at_least_32_chars
CONTROL_PLANE_INTERNAL_SECRET=regulayer_internal_secret_value_change_in_prod
GOVERNANCE_INTERNAL_SECRET=regulayer_internal_secret_value_change_in_prod
INCIDENTS_INTERNAL_SECRET=regulayer_internal_secret_value_change_in_prod

# Service URLs (Docker Network)
RECORDER_URL=http://recorder:8000
CONTROL_PLANE_URL=http://control-plane:8000
GOVERNANCE_URL=http://governance:8000
INCIDENTS_URL=http://incidents:8000

# Client-facing URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base domain (used for links, cookies, branding)
BASE_DOMAIN=regulayer.local

# Global request tracing
GLOBAL_REQUEST_ID_HEADER=X-Request-ID

# Recorder signing key (MUST be persisted via volume)
RECORDER_SIGNING_KEY_PATH=/keys/recorder_ed25519.key
