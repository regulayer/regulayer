======================================================================
SHARED CONFIGURATION
======================================================================

# Environment: dev | staging | prod
ENV=dev

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Base domain (used for links, cookies, branding)
BASE_DOMAIN=regulayer.local

# Enforce fail-fast startup on missing envs
SERVICE_FAIL_FAST=true

# Global request tracing
GLOBAL_REQUEST_ID_HEADER=X-Request-ID

======================================================================
REGULAYER RECORDER (CRYPTOGRAPHIC SOURCE OF TRUTH)
======================================================================

# Immutable recorder database (append-only)
RECORDER_DB_URL=postgresql://recorder:recorder_password@postgres:5432/regulayer_recorder

# Recorder signing key (MUST be persisted via volume)
RECORDER_SIGNING_KEY_PATH=/keys/recorder_ed25519.key

# Key lifecycle
RECORDER_KEY_ROTATION_ALLOWED=false
RECORDER_KEY_ROTATION_MODE=manual

# Legacy ingestion support (DEV only)
ALLOW_LEGACY_INGESTION=true

# Shared secret for gateway-recorder signatures
HMAC_SECRET_KEY=dev_hmac_secret_do_not_use_in_prod

# Internal service port
RECORDER_PORT=8000

======================================================================
INGESTION GATEWAY (PUBLIC ENTRYPOINT)
======================================================================

# Public HTTP port
GATEWAY_PORT=8080

# Control Plane auth endpoint
CONTROL_PLANE_URL=http://control-plane:8000

# Redis for buffering & rate limiting
REDIS_URL=redis://redis:6379

# Default throttling
DEFAULT_RATE_LIMIT_PER_MIN=100
DEFAULT_DAILY_QUOTA=10000

# Require request ID on all incoming requests
GATEWAY_REQUIRE_REQUEST_ID=true

======================================================================
CONTROL PLANE (ORG, PROJECTS, AUTH, BILLING)
======================================================================

# Control Plane database
CONTROL_DB_URL=postgresql://control:control_password@postgres:5432/regulayer_control

# Session & auth secrets (ROTATE IN PROD)
JWT_SECRET=dev_jwt_secret_do_not_use_in_prod
SESSION_SECRET=dev_session_secret_do_not_use_in_prod

# Stripe (mock in dev)
STRIPE_API_KEY=sk_test_mock_key
STRIPE_WEBHOOK_SECRET=whsec_mock_secret

# Enforce strict isolation & scope checks
CONTROL_PLANE_ENFORCE_SCOPES=true
CONTROL_PLANE_STRICT_ORG_ISOLATION=true

# Internal port
CONTROL_PLANE_PORT=8000

======================================================================
GOVERNANCE SERVICE (NON-CRYPTO OVERLAY)
======================================================================

# Governance metadata database
GOVERNANCE_DB_URL=postgresql://governance:governance_password@postgres:5432/regulayer_governance

# Governance MUST never affect crypto
GOVERNANCE_READ_ONLY_CRYPTO=true

# Internal port
GOVERNANCE_PORT=8002

======================================================================
WEB APPLICATION (NEXT.JS)
======================================================================

# Public API base (used by frontend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# App branding
NEXT_PUBLIC_APP_NAME=Regulayer

# Mandatory trust UI controls
NEXT_PUBLIC_SHOW_TRUST_BANNERS=true
NEXT_PUBLIC_DISABLE_TIME_CLAIMS=true

# Web server port
WEB_PORT=3000

======================================================================
POSTGRES (DEVELOPMENT ONLY)
======================================================================

# Bootstrap superuser (used only for init.sql)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Databases to auto-create on startup
POSTGRES_MULTIPLE_DATABASES=regulayer_recorder,regulayer_control,regulayer_governance

======================================================================
BACKUP, RESTORE & DEMO CONTROLS
======================================================================

# Backup semantics
BACKUP_MODE=append_only
RESTORE_REQUIRES_VERIFICATION=true

# Demo mode (DEV only)
DEMO_MODE_ENABLED=true
DEMO_MODE_MAX_DECISIONS=50
